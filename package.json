{
  "name": "amaea-website",
  "version": "0.1.0",
  "private": true,
  "description": "Amaea marketing website, rebuilt with the R2 design in the existing amaea.co.uk project.",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src next.config.ts eslint.config.mjs postcss.config.mjs",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.7",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
